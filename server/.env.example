PORT=4000
# Comma-separated list of allowed frontend origins (local dev + deployed URL).
CLIENT_ORIGIN=http://localhost:5173

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/openup"
REDIS_URL="redis://localhost:6379"

JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# STUN is free/public. TURN requires a real provider (metered.ca, Twilio, or self-hosted coturn) for production.
STUN_URLS="stun:stun.l.google.com:19302"
TURN_URL=""
TURN_USERNAME=""
TURN_CREDENTIAL=""
